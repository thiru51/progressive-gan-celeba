# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/

# Environments
.pixi/
.venv/
venv/
env/
.env

# Datasets. The leading slash is load-bearing: a bare "data/" also matches
# src/pgan/data/, which silently drops the dataset code from the repo and leaves
# a clean clone unable to import pgan at all.
/data/
*.parquet

# Weights. G+D+EMA is ~110 MB per run and there are 21 runs; committing them
# would make this repo unclonable. Everything else under checkpoints/ is small
# and is the evidence for RESULTS.md: the config each run used, the per-interval
# metrics, and the sample sheets.
/checkpoints*/**/*.pt
/checkpoints*/**/*.pth

# Intermediate sample grids, one every 2,000 steps across 24 runs -- 80 MB of
# them. The final grid per run is kept as the visual evidence for RESULTS.md,
# along with results/samples_by_arm.png which puts every arm side by side.
/checkpoints*/**/samples_0*.png

# Cached InceptionV3 activations for the FID reference set, ~160 MB and
# regenerable from the holdout split in one command.
/artifacts/real_features.npz

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# working notes and run outputs — local only
HANDOFF.md
PROGRESS.md
END_GOAL.md
checkpoints/
checkpoints128/
results/*.log
